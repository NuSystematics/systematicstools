@PACKAGE_INIT@

set(systematicstools_VERSION @PROJECT_VERSION@)
set(systtools_BUILD_FHICLCPP @systtools_BUILD_FHICLCPP@)

find_package(ROOT 6.10 REQUIRED)
find_package(yaml-cpp REQUIRED)

# fhiclcpp is optional. Normalize whichever package was found so the exported
# targets can always refer to fhiclcpp::standalone.
find_package(fhiclcpp QUIET)
if(TARGET fhiclcpp::fhiclcpp AND NOT TARGET fhiclcpp::standalone)
  add_library(fhiclcpp::standalone ALIAS fhiclcpp::fhiclcpp)
endif()
if(NOT fhiclcpp_FOUND)
  if(systtools_BUILD_FHICLCPP)
    include(${CMAKE_CURRENT_LIST_DIR}/../fhicl_cpp_standalone/fhicl_cpp_standaloneConfig.cmake OPTIONAL)
    if(TARGET fhiclcpp::standalone AND NOT TARGET fhiclcpp::fhiclcpp)
      add_library(fhiclcpp::fhiclcpp ALIAS fhicl_cpp_standalone)
      set(fhiclcpp_FOUND TRUE)
    endif()
  endif()
endif()

include(${CMAKE_CURRENT_LIST_DIR}/systtools-targets.cmake)

set(systematicstools_FOUND TRUE)

if(NOT TARGET systtools::all)
  message(WARNING "Expected to find target systtools::all in ${CMAKE_CURRENT_LIST_DIR}/systtools-targets.cmake")
  set(systematicstools_FOUND FALSE)
  return()
endif()
